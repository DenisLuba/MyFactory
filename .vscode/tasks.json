{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build solution (Debug|Any CPU)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/MyFactory.sln",
        "-p:Configuration=Debug",
        "-p:Platform=Any CPU"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
