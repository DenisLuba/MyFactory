<?xml version="1.0" encoding="utf-8" ?>

<toolkit:Popup
	x:Class="MyFactory.MauiClient.Controllers.SearchView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:system="clr-namespace:System;assembly=System.Runtime"
	xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	xmlns:vm="clr-namespace:MyFactory.MauiClient.Controllers"
	x:Name="SearchPopup"
	x:DataType="vm:SearchViewModel"
	x:TypeArguments="system:String">

	<Grid RowDefinitions="Auto,*">
		<Entry
			x:Name="SearchEntry"
			HorizontalOptions="Fill"
			Placeholder="Поиск..."
			Text="{Binding SearchName}"
			VerticalOptions="Center" />
		<ActivityIndicator Grid.Row="1" IsVisible="{Binding IsBusy}" />
		<CollectionView
			x:Name="ItemsCollectionView"
			Grid.Row="1"
			IsVisible="{Binding IsVisiblePage}"
			ItemsSource="{Binding FilteredItems}"
			ItemsUpdatingScrollMode="KeepScrollOffset"
			MaximumHeightRequest="400"
			MinimumHeightRequest="80"
			RemainingItemsThreshold="5"
			RemainingItemsThresholdReachedCommand="{Binding LoadNextPageCommand}"
			SelectionMode="Single">
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="vm:SearchItemDto">
					<Grid Padding="8">
						<Label Text="{Binding Name}" />
						<Grid.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding BindingContext.SelectCommand, Source={x:Reference ItemsCollectionView}}" CommandParameter="{Binding .}" />
						</Grid.GestureRecognizers>
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
	</Grid>

</toolkit:Popup>