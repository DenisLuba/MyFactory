<ContentPage
	x:Class="MyFactory.MauiClient.Pages.Orders.SalesOrders.OrderCreatePage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:converters="clr-namespace:MyFactory.MauiClient.Converters"
	xmlns:view_model="clr-namespace:MyFactory.MauiClient.ViewModels.Orders.SalesOrders"
	Title="Создание заказа"
	x:DataType="view_model:OrderCreatePageViewModel">

	<ContentPage.Resources>
		<converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
	</ContentPage.Resources>

	<Grid
		Padding="16"
		RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
		RowSpacing="12">

		<!--  Название страницы  -->
		<Label
			FontAttributes="Bold"
			FontSize="18"
			Text="Создание заказа" />

		<!--  Поиск заказчика  -->
		<Grid
			Grid.Row="1"
			ColumnDefinitions="Auto,*"
			ColumnSpacing="8">
			<Label
				FontAttributes="Bold"
				Text="Заказчик:"
				VerticalTextAlignment="Center" />
			<Entry
				Grid.Column="1"
				Placeholder="Поиск заказчика..."
				Text="{Binding Customer.Name, Mode=OneWay, TargetNullValue=''}">
				<Entry.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding CustomerEntryFocusedCommand}" />
				</Entry.GestureRecognizers>
			</Entry>
		</Grid>

		<!--  Кнопка +  -->
		<Button
			Grid.Row="2"
			Command="{Binding AddItemCommand}"
			HorizontalOptions="End"
			IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
			Text="{x:StaticResource PlusIcon}" />


		<!--  Заголовок таблицы  -->
		<Grid
			Grid.Row="3"
			Padding="16,0"
			ColumnDefinitions="2*,4*,2*,2*"
			ColumnSpacing="8">
			<Label FontAttributes="Bold" Text="Тип" />
			<Label
				Grid.Column="1"
				FontAttributes="Bold"
				Text="Товары" />
			<Label
				Grid.Column="2"
				FontAttributes="Bold"
				HorizontalTextAlignment="End"
				Text="Количество" />
		</Grid>

		<!--  Список заказов  -->
		<Border Grid.Row="4">
			<CollectionView
				x:Name="OrderItemsCollection"
				ItemsSource="{Binding Items}"
				SelectionMode="None">
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="view_model:OrderCreatePageViewModel+OrderItemViewModel">
						<Grid
							ColumnDefinitions="2*,4*,2*,2*"
							ColumnSpacing="8"
							Style="{StaticResource SelectableItemGridStyle}">
							<Picker ItemsSource="{Binding BindingContext.ProductTypeOptions, Source={x:Reference Name=OrderItemsCollection}}" SelectedItem="{Binding ProductType, Mode=TwoWay}" />
							<Entry
								Grid.Column="1"
								Placeholder="Товар..."
								Text="{Binding Product.Name, Mode=OneWay, TargetNullValue=''}">
								<Entry.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding BindingContext.ProductEntryFocusedCommand, Source={x:Reference Name=OrderItemsCollection}}" CommandParameter="{Binding .}" />
								</Entry.GestureRecognizers>
							</Entry>
							<Grid
								Grid.Column="2"
								ColumnDefinitions="*,Auto"
								ColumnSpacing="4">
								<Entry
									HorizontalTextAlignment="End"
									Keyboard="Numeric"
									Text="{Binding Qty}" />
								<Label
									Grid.Column="1"
									Text="шт."
									VerticalTextAlignment="Center" />
							</Grid>
							<Label
								Grid.Column="3"
								FontAttributes="Italic"
								HorizontalTextAlignment="End"
								Text="Удалить"
								TextColor="{StaticResource RemoveButtonColor}"
								VerticalTextAlignment="Center">
								<Label.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding BindingContext.RemoveItemCommand, Source={x:Reference Name=OrderItemsCollection}}" CommandParameter="{Binding .}" />
								</Label.GestureRecognizers>
							</Label>
						</Grid>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</Border>

		<!--  Кнопки  -->
		<Grid
			Grid.Row="5"
			ColumnDefinitions="Auto,*,Auto"
			ColumnSpacing="8">
			<Button
				Command="{Binding SaveCommand}"
				IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
				Text="Сохранить" />
			<Button
				Grid.Column="2"
				Command="{Binding CancelCommand}"
				IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
				Style="{StaticResource BackButtonStyle}"
				Text="Отмена" />
		</Grid>
	</Grid>
</ContentPage>
