<ContentPage
	x:Class="MyFactory.MauiClient.Pages.Orders.SalesOrders.OrderUpdatePage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:converters="clr-namespace:MyFactory.MauiClient.Converters"
	xmlns:view_model="clr-namespace:MyFactory.MauiClient.ViewModels.Orders.SalesOrders"
	Title="Редактирование заказа"
	x:DataType="view_model:OrderUpdatePageViewModel">

	<ContentPage.Resources>
		<converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
	</ContentPage.Resources>

	<Grid
		Padding="16"
		RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
		RowSpacing="12">
		<Grid
			x:Name="Definition"
			RowDefinitions="Auto,Auto,Auto"
			RowSpacing="8">
			<Label
				Padding="0,0,0,20"
				FontAttributes="Bold"
				FontSize="18"
				Text="{Binding TitleText}" />

			<Label
				Grid.Row="1"
				FontAttributes="Bold"
				FontSize="14"
				Text="{Binding Customer.Name, StringFormat='Заказчик:   {0}', TargetNullValue='Заказчик не установлен'}" />

			<Grid
				Grid.Row="2"
				ColumnDefinitions="*,Auto"
				ColumnSpacing="8">
				<Label
					FontAttributes="Bold"
					FontSize="14"
					Text="{Binding StatusText, StringFormat='Статус:        {0}'}"
					VerticalTextAlignment="Center" />

				<Button
					Grid.Column="1"
					Command="{Binding AddItemCommand}"
					IsEnabled="{Binding IsEdit}"
					IsVisible="{Binding IsEdit}"
					Text="{x:StaticResource PlusIcon}" />
			</Grid>
		</Grid>

		<Grid
			Grid.Row="3"
			Padding="16,0"
			ColumnDefinitions="2*,3*,1.5*,1.5*,2*"
			ColumnSpacing="8"
			IsVisible="{Binding IsEdit}">
			<Label FontAttributes="Bold" Text="Тип" />
			<Label
				Grid.Column="1"
				FontAttributes="Bold"
				Text="Товары" />
			<Label
				Grid.Column="2"
				FontAttributes="Bold"
				HorizontalTextAlignment="End"
				Text="Количество" />
			<Label
				Grid.Column="3"
				FontAttributes="Bold"
				HorizontalTextAlignment="End"
				Text="Себестоимость" />
		</Grid>

		<Grid
			Grid.Row="3"
			Padding="16,0"
			ColumnDefinitions="2*,4*,2*,2*"
			ColumnSpacing="8"
			IsVisible="{Binding IsEdit, Converter={StaticResource InvertedBoolConverter}}">
			<Label FontAttributes="Bold" Text="Тип" />
			<Label
				Grid.Column="1"
				FontAttributes="Bold"
				Text="Товары" />
			<Label
				Grid.Column="2"
				FontAttributes="Bold"
				HorizontalTextAlignment="End"
				Text="Количество" />
			<Label
				Grid.Column="3"
				FontAttributes="Bold"
				HorizontalTextAlignment="End"
				Text="Себестоимость" />
		</Grid>

		<Border Grid.Row="4">
			<Grid>
				<CollectionView
					x:Name="EditItemsCollection"
					IsVisible="{Binding IsEdit}"
					ItemsSource="{Binding Items}"
					SelectionMode="None">
					<CollectionView.ItemTemplate>
						<DataTemplate x:DataType="view_model:OrderUpdatePageViewModel+OrderItemViewModel">
							<Grid
								ColumnDefinitions="2*,3*,1.5*,1.5*,2*"
								ColumnSpacing="8"
								Style="{StaticResource SelectableItemGridStyle}">
								<Picker ItemsSource="{Binding BindingContext.ProductTypeOptions, Source={x:Reference Name=EditItemsCollection}}" SelectedItem="{Binding ProductType, Mode=TwoWay}" />
								<Entry
									Grid.Column="1"
									Placeholder="Товар..."
									Text="{Binding ProductName, Mode=OneWay, TargetNullValue=''}">
									<Entry.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding BindingContext.ProductEntryFocusedCommand, Source={x:Reference Name=EditItemsCollection}}" CommandParameter="{Binding .}" />
									</Entry.GestureRecognizers>
								</Entry>
								<Grid
									Grid.Column="2"
									ColumnDefinitions="*,Auto"
									ColumnSpacing="4">
									<Entry
										HorizontalTextAlignment="End"
										Keyboard="Numeric"
										Text="{Binding Qty}" />
									<Label
										Grid.Column="1"
										Text="шт."
										VerticalTextAlignment="Center" />
								</Grid>
								<Label
									Grid.Column="3"
									FontAttributes="Italic"
									HorizontalTextAlignment="End"
									Text="{Binding TotalCost}"
									VerticalTextAlignment="Center" />
								<Label
									Grid.Column="4"
									FontAttributes="Italic"
									HorizontalTextAlignment="End"
									Text="Удалить"
									TextColor="{StaticResource RemoveButtonColor}"
									VerticalTextAlignment="Center">
									<Label.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding BindingContext.RemoveItemCommand, Source={x:Reference Name=EditItemsCollection}}" CommandParameter="{Binding .}" />
									</Label.GestureRecognizers>
								</Label>
							</Grid>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>

				<!--  коллекция товаров для заказа режиме просмотра  -->
				<CollectionView
					IsVisible="{Binding IsEdit, Converter={StaticResource InvertedBoolConverter}}"
					ItemsSource="{Binding Items}"
					SelectionMode="None">
					<CollectionView.ItemTemplate>
						<DataTemplate x:DataType="view_model:OrderUpdatePageViewModel+OrderItemViewModel">
							<Grid
								Padding="16,4"
								ColumnDefinitions="2*,4*,2*,2*"
								ColumnSpacing="8">
								<Label Text="{Binding ProductType, TargetNullValue='-'}" VerticalTextAlignment="Center" />
								<Label
									Grid.Column="1"
									Text="{Binding ProductName, TargetNullValue='-'}"
									VerticalTextAlignment="Center" />
								<Label
									Grid.Column="2"
									HorizontalTextAlignment="End"
									Text="{Binding QtyText}"
									VerticalTextAlignment="Center" />
								<Label
									Grid.Column="3"
									HorizontalTextAlignment="End"
									Text="{Binding TotalCost}" />
							</Grid>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>
			</Grid>
		</Border>

		<Label
			Grid.Row="5"
			Padding="0,0,16,20"
			FontAttributes="Bold"
			FontSize="16"
			HorizontalTextAlignment="End"
			Text="{Binding TotalOrdersCostString}" />

		<!--  кнопки  -->
		<Grid
			Grid.Row="6"
			ColumnDefinitions="Auto,Auto,*,Auto,Auto"
			ColumnSpacing="8">
			<Button
				Command="{Binding SaveCommand}"
				IsEnabled="{Binding IsEdit}"
				IsVisible="{Binding IsEdit}"
				Text="Сохранить" />
			<Button
				Grid.Column="1"
				Command="{Binding CancelOrderCommand}"
				IsEnabled="{Binding IsEdit}"
				IsVisible="{Binding IsEdit}"
				Text="Отменить заказ" />
			<Button
				Grid.Column="3"
				Command="{Binding BackCommand}"
				Style="{StaticResource BackButtonStyle}"
				Text="Назад" />
			<Button
				Grid.Column="4"
				Command="{Binding DeleteOrderCommand}"
				IsEnabled="{Binding IsEdit}"
				IsVisible="{Binding IsEdit}"
				Style="{StaticResource RemoveButtonStyle}"
				Text="Удалить заказ" />
		</Grid>
	</Grid>
</ContentPage>
