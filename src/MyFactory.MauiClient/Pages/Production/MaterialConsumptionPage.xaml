<ContentPage
	x:Class="MyFactory.MauiClient.Pages.Production.MaterialConsumptionPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:view_model="clr-namespace:MyFactory.MauiClient.ViewModels.Production"
	Title="Списание материалов"
	x:DataType="view_model:MaterialConsumptionPageViewModel">

	<Grid
		Padding="16"
		RowDefinitions="Auto,Auto,Auto,*,Auto"
		RowSpacing="12">
		<Label
			FontAttributes="Bold"
			FontSize="18"
			Text="Списание материалов" />

		<Grid
			Grid.Row="1"
			ColumnDefinitions="Auto,*"
			ColumnSpacing="8"
			RowDefinitions="Auto">
			<Label FontAttributes="Bold" Text="Цех:" />
			<Label Grid.Column="1" Text="{Binding DepartmentName}" />
		</Grid>

		<Label
			Grid.Row="2"
			IsVisible="{Binding HasShortage}"
			Text="Не по всем материалам хватает остатков или распределено недостаточное количество."
			TextColor="{x:StaticResource RemoveButtonColor}" />

		<CollectionView
			Grid.Row="3"
			ItemsSource="{Binding Materials}"
			SelectionMode="None">
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="view_model:MaterialConsumptionPageViewModel+MaterialIssueGroupViewModel">
					<Grid
						Margin="16"
						RowDefinitions="Auto,Auto,*"
						RowSpacing="8">
						<Label
							FontAttributes="Bold"
							FontSize="16"
							Text="{Binding MaterialDisplay}" />

						<Grid
							Grid.Row="1"
							Padding="16,0"
							ColumnDefinitions="5*,3*,2*"
							ColumnSpacing="20">
							<Label FontAttributes="Bold" Text="Склад" />
							<Label
								Grid.Column="1"
								FontAttributes="Bold"
								HorizontalTextAlignment="End"
								Text="Остаётся на складе" />
							<Label
								Grid.Column="2"
								FontAttributes="Bold"
								HorizontalTextAlignment="End"
								Text="Списать" />
						</Grid>

						<Border Grid.Row="2">
							<CollectionView ItemsSource="{Binding Warehouses}" SelectionMode="None">
								<CollectionView.ItemTemplate>
									<DataTemplate x:DataType="view_model:MaterialConsumptionPageViewModel+WarehouseIssueItemViewModel">
										<Grid ColumnDefinitions="5*,3*,2*" ColumnSpacing="20">
											<Label Text="{Binding WarehouseName}" VerticalTextAlignment="Center" />
											<Label
												Grid.Column="1"
												HorizontalTextAlignment="End"
												Text="{Binding QtyDisplay}"
												VerticalTextAlignment="Center" />
											<Entry
												Grid.Column="2"
												HorizontalTextAlignment="End"
												Keyboard="Numeric"
												Text="{Binding ToConsume, StringFormat='{0:0.##}'}"
												VerticalTextAlignment="Center" />
										</Grid>
									</DataTemplate>
								</CollectionView.ItemTemplate>
							</CollectionView>
						</Border>

					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<HorizontalStackLayout Grid.Row="4" Spacing="12">
			<Button
				Command="{Binding CancelCommand}"
				Style="{StaticResource BackButtonStyle}"
				Text="Отмена" />
			<Button
				Command="{Binding IssueCommand}"
				IsEnabled="{Binding HasShortage, Converter={StaticResource InvertedBoolConverter}}"
				Text="Списать материалы" />
		</HorizontalStackLayout>
	</Grid>
</ContentPage>
