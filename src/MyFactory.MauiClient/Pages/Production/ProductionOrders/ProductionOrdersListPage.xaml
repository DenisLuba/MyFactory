<ContentPage
	x:Class="MyFactory.MauiClient.Pages.Production.ProductionOrders.ProductionOrdersListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controllers="clr-namespace:MyFactory.MauiClient.Controllers"
	xmlns:response="clr-namespace:MyFactory.MauiClient.Models.ProductionOrders"
	xmlns:view_model="clr-namespace:MyFactory.MauiClient.ViewModels.Production.ProductionOrders"
	Title="Производственные заказы"
	x:DataType="view_model:ProductionOrdersListPageViewModel">

	<Grid
		Padding="8"
		RowDefinitions="Auto,Auto,Auto,*"
		RowSpacing="8">
		<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
			<Label
				FontAttributes="Bold"
				FontSize="18"
				Text="Производственные заказы" />
			<Button
				Grid.Column="1"
				Command="{Binding AddCommand}"
				Text="{x:StaticResource PlusIcon}" />
		</Grid>

		<Grid
			Grid.Row="1"
			ColumnDefinitions="*,*,*,*,*,Auto"
			ColumnSpacing="8">
			<Picker
				Title="Статус..."
				ItemsSource="{Binding StatusOptions}"
				SelectedItem="{Binding SelectedStatus}" />

			<VerticalStackLayout
				Grid.Column="1"
				Spacing="8"
				VerticalOptions="End">
				<Label Text="Клиент..." VerticalTextAlignment="Center" />
				<Entry Placeholder="Клиент..." Text="{Binding SearchCustomerName, Mode=TwoWay}">
					<Entry.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding CustomerEntryFocusedCommand}" />
					</Entry.GestureRecognizers>
				</Entry>
			</VerticalStackLayout>

			<VerticalStackLayout
				Grid.Column="2"
				Spacing="8"
				VerticalOptions="End">
				<Label Text="Продукт..." VerticalTextAlignment="Center" />
				<Entry
					Grid.Column="2"
					Placeholder="Продукт..."
					Text="{Binding SearchProductName, Mode=TwoWay}">
					<Entry.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding ProductEntryFocusedCommand}" />
					</Entry.GestureRecognizers>
				</Entry>
			</VerticalStackLayout>

			<VerticalStackLayout
				Grid.Column="3"
				Spacing="8"
				VerticalOptions="End">
				<Label Text="Заказчик..." VerticalTextAlignment="Center" />
				<Entry
					Keyboard="Numeric"
					Placeholder="Заказчик..."
					Text="{Binding SearchSaleOrderNumber, Mode=TwoWay}">
					<Entry.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding SalesOrderEntryFocusedCommand}" />
					</Entry.GestureRecognizers>
				</Entry>
			</VerticalStackLayout>

			<VerticalStackLayout
				Grid.Column="4"
				Spacing="8"
				VerticalOptions="End">
				<Label Text="№ ПЗ..." VerticalTextAlignment="Center" />
				<Entry
					Keyboard="Numeric"
					Placeholder="№ ПЗ..."
					Text="{Binding SearchProductionOrderNumber, Mode=TwoWay}">
					<Entry.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding ProductionOrderEntryFocusedCommand}" />
					</Entry.GestureRecognizers>
				</Entry>
			</VerticalStackLayout>

			<Button
				Grid.Column="5"
				Command="{Binding ClearFiltersCommand}"
				Style="{StaticResource XButton}" />
		</Grid>

		<Grid
			Grid.Row="2"
			Padding="16,16,16,0"
			ColumnDefinitions="1*,1*,2*,2*,0.75*,0.75*,1.25*,1.25*"
			ColumnSpacing="8">
			<controllers:SortLabel
				Command="{Binding SortCommand}"
				HorizontalTextAlignment="Start"
				IsDescending="{Binding IsDescending}"
				SortKey="number"
				Text="№ ПЗ" />
			<controllers:SortLabel
				Grid.Column="1"
				Command="{Binding SortCommand}"
				HorizontalTextAlignment="End"
				IsDescending="{Binding IsDescending}"
				SortKey="salesordernumber"
				Text="№ Заказа" />
			<controllers:SortLabel
				Grid.Column="2"
				Command="{Binding SortCommand}"
				HorizontalTextAlignment="End"
				IsDescending="{Binding IsDescending}"
				SortKey="customername"
				Text="Клиент" />
			<controllers:SortLabel
				Grid.Column="3"
				Command="{Binding SortCommand}"
				HorizontalTextAlignment="End"
				IsDescending="{Binding IsDescending}"
				SortKey="productname"
				Text="Продукт" />
			<Label
				Grid.Column="4"
				FontAttributes="Bold"
				HorizontalTextAlignment="End"
				Text="Всего" />
			<Label
				Grid.Column="5"
				FontAttributes="Bold"
				HorizontalTextAlignment="End"
				Text="Отгружено" />
			<Label
				Grid.Column="6"
				FontAttributes="Bold"
				HorizontalTextAlignment="End"
				Text="Статус" />
		</Grid>

		<Border Grid.Row="3">
			<CollectionView
				x:Name="ProductionOrdersCollection"
				ItemsSource="{Binding FilteredItems}"
				ItemsUpdatingScrollMode="KeepScrollOffset"
				RemainingItemsThreshold="5"
				RemainingItemsThresholdReachedCommand="{Binding LoadNextPageCommand}"
				SelectionMode="None">
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="response:ProductionOrderListItemResponse">
						<SwipeView>
							<SwipeView.RightItems>
								<SwipeItems Mode="Reveal">
									<SwipeItem
										BackgroundColor="LightGray"
										Command="{Binding BindingContext.OpenStagesCommand, Source={x:Reference Name=ProductionOrdersCollection}}"
										CommandParameter="{Binding .}"
										Text="Этапы" />
									<SwipeItem
										BackgroundColor="Gainsboro"
										Command="{Binding BindingContext.OpenOrderCommand, Source={x:Reference Name=ProductionOrdersCollection}}"
										CommandParameter="{Binding .}"
										Text="ПЗ" />
									<SwipeItem
										BackgroundColor="Tomato"
										Command="{Binding BindingContext.DeleteCommand, Source={x:Reference Name=ProductionOrdersCollection}}"
										CommandParameter="{Binding .}"
										Text="Удалить" />
								</SwipeItems>
							</SwipeView.RightItems>
							<Grid ColumnDefinitions="1*,1*,2*,2*,0.75*,0.75*,1.25*,1.25*" ColumnSpacing="8">
								<Grid.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding BindingContext.OpenDetailsCommand, Source={x:Reference Name=ProductionOrdersCollection}}" CommandParameter="{Binding .}" />
								</Grid.GestureRecognizers>
								<Label HorizontalTextAlignment="Start" Text="{Binding ProductionOrderNumber}" />
								<Label
									Grid.Column="1"
									HorizontalTextAlignment="End"
									Text="{Binding SalesOrderNumber}" />
								<Label
									Grid.Column="2"
									HorizontalTextAlignment="End"
									Text="{Binding CustomerName}" />
								<Label
									Grid.Column="3"
									HorizontalTextAlignment="End"
									Text="{Binding ProductName}" />
								<Label
									Grid.Column="4"
									HorizontalTextAlignment="End"
									Text="{Binding QtyPlanned}" />
								<Label
									Grid.Column="5"
									HorizontalTextAlignment="End"
									Text="{Binding QtyFinished}" />
								<Label
									Grid.Column="6"
									HorizontalTextAlignment="End"
									Text="{Binding Status, Converter={StaticResource StatusToRusConverter}}" />
								<Label
									Grid.Column="7"
									FontAttributes="Italic"
									HorizontalTextAlignment="End"
									Text="Удалить"
									TextColor="{StaticResource RemoveButtonColor}">
									<Label.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding BindingContext.DeleteCommand, Source={x:Reference Name=ProductionOrdersCollection}}" CommandParameter="{Binding .}" />
									</Label.GestureRecognizers>
								</Label>
							</Grid>
						</SwipeView>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</Border>
	</Grid>
</ContentPage>

