<ContentPage
	x:Class="MyFactory.MauiClient.Pages.Products.ProductEditPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:converters="clr-namespace:MyFactory.MauiClient.Converters"
	xmlns:view_model="clr-namespace:MyFactory.MauiClient.ViewModels.Products"
	x:Name="ProductEditPageRoot"
	Title="{Binding PageTitle}"
	x:DataType="view_model:ProductEditPageViewModel">

	<ContentPage.Resources>
		<converters:MaterialOptionsToNamesConverter x:Key="MaterialNamesToListConverter" />
		<converters:DepartmentOptionsToNamesConverter x:Key="DepartmentNamesToListConverter" />
	</ContentPage.Resources>
	<ScrollView>
		<Grid
			Padding="16"
			RowDefinitions="Auto,Auto,Auto,Auto,*"
			RowSpacing="12">
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
				<Button Command="{Binding SaveCommand}" Text="Сохранить" />
				<Button
					Grid.Column="1"
					Command="{Binding CancelCommand}"
					HorizontalOptions="End"
					Style="{StaticResource BackButtonStyle}"
					Text="Отмена" />
			</Grid>
			<Grid
				Grid.Row="1"
				ColumnDefinitions="Auto,*"
				ColumnSpacing="8"
				RowDefinitions="0.1*,0.1*,0.1*,0.3*,0.1*,0.1*"
				RowSpacing="8">
				<Label
					FontAttributes="Bold"
					Text="Название:"
					VerticalTextAlignment="Center" />
				<Entry
					Grid.Column="1"
					Placeholder="Название"
					ReturnType="Next"
					Text="{Binding Name}" />

				<Label
					Grid.Row="1"
					FontAttributes="Bold"
					Text="Тип товара:"
					VerticalTextAlignment="Center" />
				<Picker
					Grid.Row="1"
					Grid.Column="1"
					ItemDisplayBinding="{Binding Type}"
					ItemsSource="{Binding ProductTypeOptions}"
					SelectedItem="{Binding SelectedProductTypeOption}" />

				<Label
					Grid.Row="2"
					FontAttributes="Bold"
					Text="План/час:"
					VerticalTextAlignment="Center" />
				<Entry
					Grid.Row="2"
					Grid.Column="1"
					Keyboard="Numeric"
					Placeholder="План/час"
					ReturnType="Next"
					Text="{Binding PlanPerHour}" />

				<Label
					Grid.Row="3"
					FontAttributes="Bold"
					Text="Описание"
					VerticalTextAlignment="Center" />
				<Editor
					Grid.Row="3"
					Grid.Column="1"
					HeightRequest="80"
					Placeholder="Описание"
					Text="{Binding Description}" />

				<Label
					Grid.Row="4"
					FontAttributes="Bold"
					Text="Версия"
					VerticalTextAlignment="Center" />
				<Entry
					Grid.Row="4"
					Grid.Column="1"
					Placeholder="Версия"
					ReturnType="Next"
					Text="{Binding Version}" />

				<Label
					Grid.Row="5"
					FontAttributes="Bold"
					Text="Статус"
					VerticalTextAlignment="Center" />
				<Picker
					Grid.Row="5"
					Grid.Column="1"
					x:DataType="view_model:ProductEditPageViewModel"
					ItemsSource="{Binding StatusOptions}"
					SelectedItem="{Binding Status}" />
			</Grid>

			<Grid
				Grid.Row="2"
				ColumnDefinitions="*,Auto,Auto"
				ColumnSpacing="8">
				<Button
					Grid.Column="1"
					Command="{Binding AddImageCommand}"
					Text="{x:StaticResource PlusIcon}">
					<Button.Triggers>
						<DataTrigger
							Binding="{Binding Images.Count}"
							TargetType="Button"
							Value="0">
							<Setter Property="Text" Value="+ Изображение" />
						</DataTrigger>
					</Button.Triggers>
				</Button>
				<Button
					Grid.Column="2"
					Command="{Binding DeleteImageCommand}"
					CommandParameter="{Binding SelectedImage}"
					IsEnabled="{Binding IsSelected}"
					IsVisible="{Binding IsSelected}"
					Text="-" />
			</Grid>

			<CollectionView
				x:Name="ImageList"
				Grid.Row="3"
				ItemsLayout="HorizontalList"
				ItemsSource="{Binding Images}"
				SelectedItem="{Binding SelectedImage}"
				SelectionMode="Single">
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="view_model:ProductEditPageViewModel+ImageItemViewModel">
						<Border Padding="0" BackgroundColor="Transparent">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="0" />
							</Border.StrokeShape>
							<Image
								Aspect="AspectFill"
								HeightRequest="120"
								Source="{Binding Source}" />
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

			<Grid
				Grid.Row="4"
				Margin="0,0,12,0"
				RowDefinitions="*,*"
				RowSpacing="8">

				<!--  СПЕЦИФИКАЦИЯ  -->

				<Border>
					<Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
						<Grid
							Grid.Row="0"
							ColumnDefinitions="*,Auto,Auto"
							ColumnSpacing="8">
							<Label FontAttributes="Bold" Text="СПЕЦИФИКАЦИЯ" />
							<Button
								Grid.Column="1"
								Command="{Binding AddMaterialCommand}"
								HorizontalOptions="End"
								Text="{x:StaticResource PlusIcon}" />
							<Button
								Grid.Column="2"
								Command="{Binding RemoveMaterialsCommand}"
								HorizontalOptions="End"
								IsEnabled="{Binding AreMaterialsSelected}"
								IsVisible="{Binding AreMaterialsSelected}"
								Text="-" />
						</Grid>
						<Grid
							Grid.Row="1"
							Padding="0,8,0,0"
							ColumnDefinitions="0.6*,0.3*,0.03*"
							ColumnSpacing="8">
							<Label
								Padding="64,0,0,0"
								FontAttributes="Bold"
								Text="Материал" />
							<Label
								Grid.Column="1"
								FontAttributes="Bold"
								HorizontalTextAlignment="End"
								Text="Количество" />
						</Grid>
						<CollectionView
							x:Name="BomEditCollection"
							Grid.Row="2"
							ItemsSource="{Binding EditableBom}"
							SelectedItems="{Binding SelectedMaterials, Mode=TwoWay}"
							SelectionMode="Multiple">
							<CollectionView.ItemTemplate>
								<DataTemplate x:DataType="view_model:ProductEditPageViewModel+BomEditItemViewModel">
									<Grid
										Padding="32,0,6,0"
										ColumnDefinitions="0.6*,0.3*,0.03*"
										ColumnSpacing="8">
										<Entry Placeholder="Материалы..." Text="{Binding Material.Name, Mode=OneWay, TargetNullValue=''}">
											<Entry.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding BindingContext.MaterialEntryFocusedCommand, Source={x:Reference BomEditCollection}}" CommandParameter="{Binding .}" />
											</Entry.GestureRecognizers>
										</Entry>
										<Entry
											Grid.Column="1"
											HorizontalTextAlignment="End"
											Keyboard="Numeric"
											Text="{Binding Quantity}" />
										<Label
											Grid.Column="2"
											FontAttributes="Italic"
											HorizontalTextAlignment="Start"
											Text="{Binding Unit}"
											VerticalTextAlignment="Center" />
									</Grid>
								</DataTemplate>
							</CollectionView.ItemTemplate>
						</CollectionView>
					</Grid>
				</Border>

				<!--  ПРОИЗВОДСТВО  -->

				<Border Grid.Row="1">
					<Grid RowDefinitions="Auto,*" RowSpacing="8">
						<Grid ColumnDefinitions="*,Auto,Auto">
							<Label FontAttributes="Bold" Text="Производственные затраты" />
							<Button
								Grid.Column="1"
								Command="{Binding AddDepartmentCommand}"
								Text="{x:StaticResource PlusIcon}" />
							<Button
								Grid.Column="2"
								Command="{Binding RemoveDepartmentsCommand}"
								IsEnabled="{Binding AreDepartmentsSelected}"
								IsVisible="{Binding AreDepartmentsSelected}"
								Text="-" />
						</Grid>
						<Grid
							Grid.Row="1"
							RowDefinitions="Auto,*"
							RowSpacing="8">
							<Grid
								Padding="0,8,0,0"
								ColumnDefinitions="0.3*,0.175*,0.175*,0.175*,0.175*"
								ColumnSpacing="8">
								<Label
									Padding="64,0,0,0"
									FontAttributes="Bold"
									Text="Цех" />
								<Label
									Grid.Column="1"
									FontAttributes="Bold"
									HorizontalTextAlignment="End"
									Text="Раскрой" />
								<Label
									Grid.Column="2"
									FontAttributes="Bold"
									HorizontalTextAlignment="End"
									Text="Пошив" />
								<Label
									Grid.Column="3"
									FontAttributes="Bold"
									HorizontalTextAlignment="End"
									Text="Упаковка" />
								<Label
									Grid.Column="4"
									FontAttributes="Bold"
									HorizontalTextAlignment="End"
									Text="Прочее" />
							</Grid>
							<CollectionView
								x:Name="ProductionCostsEditCollection"
								Grid.Row="1"
								ItemsSource="{Binding EditableProductionCosts}"
								SelectedItems="{Binding SelectedDepartments, Mode=TwoWay}"
								SelectionMode="Multiple">
								<CollectionView.ItemTemplate>
									<DataTemplate x:DataType="view_model:ProductEditPageViewModel+ProductionCostEditViewModel">
										<Grid
											Padding="32,0,0,0"
											ColumnDefinitions="0.3*,0.175*,0.175*,0.175*,0.175*"
											ColumnSpacing="8">
											<Picker
												ItemDisplayBinding="{Binding Name}"
												ItemsSource="{Binding BindingContext.DepartmentOptions, Source={x:Reference ProductEditPageRoot}}"
												SelectedItem="{Binding Department}" />
											<Entry
												Grid.Column="1"
												HorizontalTextAlignment="End"
												Keyboard="Numeric"
												Text="{Binding Cutting}" />
											<Entry
												Grid.Column="2"
												HorizontalTextAlignment="End"
												Keyboard="Numeric"
												Text="{Binding Sewing}" />
											<Entry
												Grid.Column="3"
												HorizontalTextAlignment="End"
												Keyboard="Numeric"
												Text="{Binding Packaging}" />
											<Entry
												Grid.Column="4"
												HorizontalTextAlignment="End"
												Keyboard="Numeric"
												Text="{Binding Other}" />
										</Grid>
									</DataTemplate>
								</CollectionView.ItemTemplate>
							</CollectionView>
						</Grid>
					</Grid>
				</Border>
			</Grid>
		</Grid>
	</ScrollView>
</ContentPage>

