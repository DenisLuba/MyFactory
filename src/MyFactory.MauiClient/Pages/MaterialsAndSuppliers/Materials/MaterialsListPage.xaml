<ContentPage
	x:Class="MyFactory.MauiClient.Pages.MaterialsAndSuppliers.Materials.MaterialsListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controllers="clr-namespace:MyFactory.MauiClient.Controllers"
	xmlns:response="clr-namespace:MyFactory.MauiClient.Models.Materials"
	xmlns:viewModel="clr-namespace:MyFactory.MauiClient.ViewModels.MaterialsAndSuppliers.Materials"
	Title="Материалы"
	x:DataType="viewModel:MaterialsListPageViewModel">

	<Grid
		Padding="16"
		RowDefinitions="Auto,Auto,Auto,*"
		RowSpacing="12">
		<Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
			<Entry Placeholder="Поиск по типу материала" Text="{Binding SearchType}" />
			<Entry
				Grid.Column="1"
				Placeholder="Поиск по материалу"
				Text="{Binding SearchText}" />
			<Button
				Grid.Column="2"
				Command="{Binding AddCommand}"
				IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
				Text="+ Добавить" />
		</Grid>

		<Grid
			Grid.Row="1"
			Padding="16,16,16,0"
			ColumnDefinitions="0.25*,0.6*,0.15*"
			ColumnSpacing="8">
			<controllers:SortLabel
				Command="{Binding SortCommand}"
				IsDescending="{Binding IsDescending}"
				SortKey="type"
				Text="Тип материала" />
			<controllers:SortLabel
				Grid.Column="1"
				Command="{Binding SortCommand}"
				IsDescending="{Binding IsDescending}"
				SortKey="name"
				Text="Материал" />
			<controllers:SortLabel
				Grid.Column="2"
				Command="{Binding SortCommand}"
				IsDescending="{Binding IsDescending}"
				SortKey="qty"
				Text="Остаток" />
		</Grid>

		<ActivityIndicator
			Grid.Row="2"
			IsRunning="{Binding IsBusy}"
			IsVisible="{Binding IsBusy}" />

		<Border Grid.Row="3">
			<CollectionView
				x:Name="MaterialsListCollection"
				ItemsSource="{Binding FilteredItems}"
				ItemsUpdatingScrollMode="KeepScrollOffset"
				RemainingItemsThreshold="5"
				RemainingItemsThresholdReachedCommand="{Binding LoadNextPageCommand}"
				SelectionMode="None">
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="response:MaterialListItemResponse">
						<SwipeView>
							<SwipeView.RightItems>
								<SwipeItems Mode="Reveal">
									<SwipeItem
										BackgroundColor="{StaticResource BaseButtonColor}"
										Command="{Binding BindingContext.EditCommand, Source={x:Reference Name=MaterialsListCollection}}"
										CommandParameter="{Binding .}"
										Text="Редактировать" />
									<SwipeItem
										BackgroundColor="{StaticResource RemoveButtonColor}"
										Command="{Binding BindingContext.DeleteCommand, Source={x:Reference Name=MaterialsListCollection}}"
										CommandParameter="{Binding .}"
										Text="Удалить" />
								</SwipeItems>
							</SwipeView.RightItems>
							<Grid
								ColumnDefinitions="0.25*,0.6*,0.15*"
								ColumnSpacing="8"
								Style="{StaticResource SelectableItemGridStyle}">
								<Grid.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding BindingContext.OpenDetailsCommand, Source={x:Reference Name=MaterialsListCollection}}" CommandParameter="{Binding .}" />
								</Grid.GestureRecognizers>
								<Label Text="{Binding MaterialType}" />
								<Label Grid.Column="1" Text="{Binding Name}" />
								<Label Grid.Column="2">
									<Label.FormattedText>
										<FormattedString>
											<Span Text="{Binding TotalQty, StringFormat='{0:0.##}'}" />
											<Span Text=" " />
											<Span Text="{Binding UnitCode}" />
										</FormattedString>
									</Label.FormattedText>
								</Label>
							</Grid>
						</SwipeView>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</Border>
	</Grid>
</ContentPage>

