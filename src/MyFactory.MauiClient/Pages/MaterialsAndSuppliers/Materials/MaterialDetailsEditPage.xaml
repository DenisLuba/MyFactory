<ContentPage
	x:Class="MyFactory.MauiClient.Pages.MaterialsAndSuppliers.Materials.MaterialDetailsEditPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:view_model="clr-namespace:MyFactory.MauiClient.ViewModels.MaterialsAndSuppliers.Materials"
	Title="{Binding PageTitle}"
	x:DataType="view_model:MaterialDetailsEditPageViewModel">

	<ScrollView>
		<Grid
			Padding="16"
			RowDefinitions="Auto,Auto,Auto,Auto"
			RowSpacing="12">
			<Grid
				ColumnDefinitions="Auto,*"
				ColumnSpacing="8"
				RowDefinitions="Auto,Auto,Auto,Auto,Auto"
				RowSpacing="8">
				<Label
					FontAttributes="Bold"
					Text="Материал:"
					VerticalTextAlignment="Center" />
				<Entry
					Grid.Column="1"
					Placeholder="Название"
					Text="{Binding Name}" />

				<Label
					Grid.Row="1"
					FontAttributes="Bold"
					Text="Тип:"
					VerticalTextAlignment="Center" />
				<Picker
					Grid.Row="1"
					Grid.Column="1"
					ItemsSource="{Binding MaterialTypes}"
					SelectedItem="{Binding SelectedMaterialType}" />

				<Label
					Grid.Row="2"
					FontAttributes="Bold"
					Text="Единицы измерения: "
					VerticalTextAlignment="Center" />
				<Picker
					Grid.Row="2"
					Grid.Column="1"
					ItemsSource="{Binding Units}"
					SelectedItem="{Binding SelectedUnit}" />

				<Label
					Grid.Row="3"
					FontAttributes="Bold"
					Text="Цвет:"
					VerticalTextAlignment="Center" />
				<Entry
					Grid.Row="3"
					Grid.Column="1"
					Placeholder="Цвет"
					Text="{Binding Color}" />

				<Label
					Grid.Row="4"
					FontAttributes="Bold"
					Text="Описание:"
					VerticalTextAlignment="Center" />
				<Editor
					Grid.Row="4"
					Grid.Column="1"
					Placeholder="Описание"
					Text="{Binding Description}" />
			</Grid>

			<Grid Grid.Row="1" ColumnDefinitions="Auto,*">
				<Button
					Command="{Binding SaveCommand}"
					IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
					Text="Сохранить" />
				<Button
					Grid.Column="1"
					Command="{Binding CancelCommand}"
					HorizontalOptions="End"
					IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
					Style="{StaticResource BackButtonStyle}"
					Text="Отменить" />
			</Grid>

			<Grid
				Grid.Row="2"
				ColumnDefinitions="*,Auto,Auto"
				ColumnSpacing="8">
				<Button
					Grid.Column="1"
					Command="{Binding AddImageCommand}"
					IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
					Text="{x:StaticResource PlusIcon}">
					<Button.Triggers>
						<DataTrigger
							Binding="{Binding Images.Count}"
							TargetType="Button"
							Value="0">
							<Setter Property="Text" Value="+ Изображение" />
						</DataTrigger>
					</Button.Triggers>
				</Button>
				<Button
					Grid.Column="2"
					Command="{Binding DeleteImageCommand}"
					CommandParameter="{Binding SelectedImage}"
					IsEnabled="{Binding IsSelected}"
					IsVisible="{Binding IsSelected}"
					Text="-" />
			</Grid>

			<CollectionView
				x:Name="ImageList"
				Grid.Row="3"
				ItemsLayout="HorizontalList"
				ItemsSource="{Binding Images}"
				SelectedItem="{Binding SelectedImage}"
				SelectionMode="Single">
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="view_model:MaterialDetailsEditPageViewModel+ImageItemViewModel">
						<Border Padding="0" BackgroundColor="Transparent">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="0" />
							</Border.StrokeShape>
							<Image
								Aspect="AspectFill"
								HeightRequest="120"
								Source="{Binding Source}" />
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>


