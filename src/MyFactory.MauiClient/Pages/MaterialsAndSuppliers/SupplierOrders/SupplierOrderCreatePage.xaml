<ContentPage
	x:Class="MyFactory.MauiClient.Pages.MaterialsAndSuppliers.SupplierOrders.SupplierOrderCreatePage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:view_model="clr-namespace:MyFactory.MauiClient.ViewModels.MaterialsAndSuppliers.SupplierOrders"
	Title="Создание заказа поставщику"
	x:DataType="view_model:SupplierOrderCreatePageViewModel">
	<Grid
		Padding="16"
		RowDefinitions="Auto,Auto,Auto,*,Auto"
		RowSpacing="12">
		<Grid ColumnDefinitions="*,Auto, Auto, Auto" ColumnSpacing="8">
			<Label
				FontAttributes="Bold"
				FontSize="18"
				Text="Создание заказа" />
			<Button
				Grid.Column="1"
				Command="{Binding AddItemCommand}"
				IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
				Text="{x:StaticResource PlusIcon}" />
			<Button
				Grid.Column="2"
				Command="{Binding RemoveSelectedCommand}"
				IsEnabled="{Binding HasSelectedItems}"
				IsVisible="{Binding HasSelectedItems}"
				Text="-" />
		</Grid>

		<Entry
			Grid.Row="1"
			Placeholder="Поставщик..."
			Text="{Binding Supplier.Name, Mode=OneWay, TargetNullValue=''}">
			<Entry.GestureRecognizers>
				<TapGestureRecognizer Command="{Binding SupplierEntryFocusedCommand}" />
			</Entry.GestureRecognizers>
		</Entry>

		<Grid
			Grid.Row="2"
			Padding="80,0,32,0"
			ColumnDefinitions="3*,3*,3*,1*"
			ColumnSpacing="8">
			<Label
				FontAttributes="Bold"
				HorizontalTextAlignment="Start"
				Text="Тип" />
			<Label
				Grid.Column="1"
				FontAttributes="Bold"
				HorizontalTextAlignment="End"
				Text="Материал" />
			<Label
				Grid.Column="2"
				FontAttributes="Bold"
				HorizontalTextAlignment="End"
				Text="Количество" />
			<Label
				Grid.Column="3"
				FontAttributes="Bold"
				HorizontalTextAlignment="End"
				Text="Цена" />
		</Grid>

		<Border Grid.Row="3">
			<CollectionView
				x:Name="SupplierOrderItemsCollection"
				Grid.Row="1"
				ItemsSource="{Binding Items}"
				SelectedItems="{Binding SelectedItems, Mode=TwoWay}"
				SelectionMode="Multiple">
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="view_model:SupplierOrderCreatePageViewModel+OrderItemViewModel">
						<Grid
							Padding="32,0,6,0"
							ColumnDefinitions="3*,3*,3*,1*"
							ColumnSpacing="8"
							Style="{StaticResource SelectableItemGridStyle}">
							<Picker ItemsSource="{Binding BindingContext.MaterialTypeOptions, Source={x:Reference Name=SupplierOrderItemsCollection}}" SelectedItem="{Binding MaterialType}" />
							<Entry
								Grid.Column="1"
								HorizontalTextAlignment="End"
								Placeholder="Материал..."
								Text="{Binding MaterialName, Mode=OneWay, TargetNullValue=''}">
								<Entry.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding BindingContext.MaterialEntryFocusedCommand, Source={x:Reference SupplierOrderItemsCollection}}" CommandParameter="{Binding .}" />
								</Entry.GestureRecognizers>
							</Entry>
							<Grid
								Grid.Column="2"
								ColumnDefinitions="*,Auto"
								ColumnSpacing="4">
								<Entry
									HorizontalOptions="Fill"
									HorizontalTextAlignment="End"
									Keyboard="Numeric"
									Text="{Binding Qty, StringFormat='{0:0.##}'}" />
								<Label
									Grid.Column="1"
									HorizontalTextAlignment="Start"
									Text="{Binding UnitCode}"
									VerticalTextAlignment="Center" />
							</Grid>
							<Entry
								Grid.Column="3"
								HorizontalTextAlignment="End"
								Keyboard="Numeric"
								Text="{Binding Price, StringFormat='{0:0.##}'}" />
						</Grid>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</Border>

		<Grid
			Grid.Row="4"
			ColumnDefinitions="Auto,Auto,*"
			ColumnSpacing="8">
			<Button
				Command="{Binding SaveCommand}"
				IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
				Text="Сохранить" />
			<Button
				Grid.Column="1"
				Command="{Binding SaveFileCommand}"
				IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
				Text="Сохранить файл" />
			<Button
				Grid.Column="2"
				Command="{Binding BackCommand}"
				HorizontalOptions="End"
				IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
				Style="{StaticResource BackButtonStyle}"
				Text="Назад" />
		</Grid>
	</Grid>
</ContentPage>
